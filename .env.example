# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# Alpaca market-data credentials.
# Paper keys work fine: historical bars are served from
# https://data.alpaca.markets for BOTH paper and live accounts.
# (paper-api.alpaca.markets is for ORDERS only, not bars.)
ALPACA_API_KEY=your_key_id_here
ALPACA_SECRET_KEY=your_secret_here

# Optional overrides
# ALPACA_BASE_URL=https://data.alpaca.markets
